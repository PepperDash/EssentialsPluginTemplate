<Project>
  <ItemGroup>
    <None Include="$(TargetDir)\$(TargetName).$(Version).cpz" Condition="$(ProjectType) == 'Program'">
      <Pack>true</Pack>
      <PackagePath>content;</PackagePath>
    </None>
    <None Include="$(PackageOutputPath)\$(TargetName).$(Version).cplz" Condition="$(ProjectType) == 'ProgramLibrary'">
      <Pack>true</Pack>
      <PackagePath>content;</PackagePath>
    </None>
  </ItemGroup>
  <Target Name="Create CPLZ" AfterTargets="Build; Rebuild" Condition="$(ProjectType) == 'ProgramLibrary'">
    <Message Text="Creating CPLZ"></Message>
    <MakeDir Directories="$(PackageOutputPath)" Condition="!Exists($(PackageOutputPath))"></MakeDir>
    <ZipDirectory SourceDirectory="$(TargetDir)" DestinationFile="$(PackageOutputPath)\$(TargetName).$(Version).cplz" Overwrite="true"/>
  </Target>
  <Target Name="Clean CPLZ" AfterTargets="AfterClean" Condition="$(ProjectType) == 'ProgramLibrary'">
    <Delete Files="$(PackageOutputPath)\$(TargetName).$(Version).cplz"/>
  </Target>
  <!-- Installs git hooks on restore; skipped in CI or with HUSKY=0 -->
  <Target Name="InstallGitHooks" BeforeTargets="Restore;CollectPackageReferences" Condition="'$(HUSKY)' != '0' And '$(CI)' != 'true' And Exists('$(MSBuildThisFileDirectory)..\.git')">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildThisFileDirectory).." StandardOutputImportance="Low" StandardErrorImportance="High" ContinueOnError="true" />
    <Exec Command="dotnet husky install" WorkingDirectory="$(MSBuildThisFileDirectory).." StandardOutputImportance="Low" StandardErrorImportance="High" ContinueOnError="true" />
  </Target>

  <!--
    README sync, by pd-readme (PepperDash.Essentials.BuildTools.Readme, pinned in .config/dotnet-tools.json).
    Badges: .NET from $(TargetFramework), PepperDash Essentials from the highest MinimumEssentialsFrameworkVersion
    assignment in the project's C# files (factories can have any name). Rewritten before build locally;
    checked (build error on drift) when CI=true or -p:ReadmeMode=Check. Opt out: -p:SkipReadmeBadges=true
    Docs: the START/END marker sections under "Plugin Documentation" (config example, supported types, join maps,
    feedbacks, public methods). Not part of the normal build: run `dotnet msbuild -t:UpdateReadmeDocs` (or
    `dotnet pd-readme docs`), review the diff, commit it. Checked like the badges. Opt out: -p:SkipReadmeDocsCheck=true
    The tool needs the .NET 8 runtime (it does not roll forward to 9 or later); it is restored here because InstallGitHooks does not run in CI.
  -->
  <PropertyGroup>
    <ReadmePath Condition="'$(ReadmePath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../README.md'))</ReadmePath>
    <ReadmeMode Condition="'$(ReadmeMode)' == '' And '$(CI)' == 'true'">Check</ReadmeMode>
    <ReadmeMode Condition="'$(ReadmeMode)' == ''">Update</ReadmeMode>
    <_ReadmeBadgesEnabled Condition="'$(ProjectType)' == 'ProgramLibrary' And '$(DesignTimeBuild)' != 'true' And '$(TargetFramework)' != '' And '$(SkipReadmeBadges)' != 'true' And Exists('$(ReadmePath)')">true</_ReadmeBadgesEnabled>
    <_ReadmeDocsEnabled Condition="'$(ProjectType)' == 'ProgramLibrary' And '$(DesignTimeBuild)' != 'true' And '$(TargetFramework)' != '' And Exists('$(ReadmePath)')">true</_ReadmeDocsEnabled>
    <_ReadmeToolManifest>$(MSBuildThisFileDirectory)../.config/dotnet-tools.json</_ReadmeToolManifest>
    <_ReadmeToolRoot>$(MSBuildThisFileDirectory)..</_ReadmeToolRoot>
    <_ReadmeArgs>--project "$(MSBuildProjectFullPath)" --readme "$(ReadmePath)"</_ReadmeArgs>
  </PropertyGroup>

  <Target Name="_CollectReadmeBadgeInputs" >
    <PropertyGroup>
      <_ReadmeEssentialsVersion>@(PackageReference->WithMetadataValue('Identity', 'PepperDashEssentials')->'%(Version)')</_ReadmeEssentialsVersion>
      <!-- Resolved by MSBuild, so it is right whether TargetFramework comes from the csproj or Directory.Build.props -->
      <_ReadmeBadgeArgs>$(_ReadmeArgs) --target-framework "$(TargetFramework)"</_ReadmeBadgeArgs>
      <_ReadmeBadgeArgs Condition="'$(_ReadmeEssentialsVersion)' != ''">$(_ReadmeBadgeArgs) --essentials-version "$(_ReadmeEssentialsVersion)"</_ReadmeBadgeArgs>
    </PropertyGroup>
  </Target>

  <!-- Not incremental: a timestamp check misses deleted factories and imported property changes (TargetFramework in Directory.Build.props). The tool is a no-op when the badges are current. -->
  <Target Name="UpdateReadmeBadges" BeforeTargets="BeforeBuild" DependsOnTargets="_CollectReadmeBadgeInputs"
          Condition="'$(_ReadmeBadgesEnabled)' == 'true' And '$(ReadmeMode)' != 'Check'">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(_ReadmeToolRoot)" StandardOutputImportance="Low" StandardErrorImportance="High" />
    <Exec Command="dotnet pd-readme badges $(_ReadmeBadgeArgs)" WorkingDirectory="$(_ReadmeToolRoot)" StandardOutputImportance="High" />
  </Target>

  <Target Name="CheckReadmeBadges" BeforeTargets="BeforeBuild" DependsOnTargets="_CollectReadmeBadgeInputs"
          Condition="'$(_ReadmeBadgesEnabled)' == 'true' And '$(ReadmeMode)' == 'Check'">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(_ReadmeToolRoot)" StandardOutputImportance="Low" StandardErrorImportance="High" />
    <Exec Command="dotnet pd-readme badges $(_ReadmeBadgeArgs) --check" WorkingDirectory="$(_ReadmeToolRoot)" StandardOutputImportance="High" />
  </Target>

  <!-- Skipped for projects that do not own the README (e.g. test projects), so it can be run against the solution -->
  <Target Name="UpdateReadmeDocs" Condition="'$(_ReadmeDocsEnabled)' == 'true'">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(_ReadmeToolRoot)" StandardOutputImportance="Low" StandardErrorImportance="High" />
    <Exec Command="dotnet pd-readme docs $(_ReadmeArgs)" WorkingDirectory="$(_ReadmeToolRoot)" StandardOutputImportance="High" />
  </Target>

  <Target Name="CheckReadmeDocs" AfterTargets="CheckReadmeBadges"
          Condition="'$(_ReadmeDocsEnabled)' == 'true' And '$(ReadmeMode)' == 'Check' And '$(SkipReadmeDocsCheck)' != 'true'">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(_ReadmeToolRoot)" StandardOutputImportance="Low" StandardErrorImportance="High" />
    <Exec Command="dotnet pd-readme docs $(_ReadmeArgs) --check" WorkingDirectory="$(_ReadmeToolRoot)" StandardOutputImportance="High" />
  </Target>
</Project>
