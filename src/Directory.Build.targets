<Project>
  <ItemGroup>
    <None Include="$(TargetDir)\$(TargetName).$(Version).cpz" Condition="$(ProjectType) == 'Program'">
      <Pack>true</Pack>
      <PackagePath>content;</PackagePath>
    </None>
    <None Include="$(PackageOutputPath)\$(TargetName).$(Version).cplz" Condition="$(ProjectType) == 'ProgramLibrary'">
      <Pack>true</Pack>
      <PackagePath>content;</PackagePath>
    </None>
  </ItemGroup>
  <Target Name="Create CPLZ" AfterTargets="Build; Rebuild" Condition="$(ProjectType) == 'ProgramLibrary'">
    <Message Text="Creating CPLZ"></Message>
    <MakeDir Directories="$(PackageOutputPath)" Condition="!Exists($(PackageOutputPath))"></MakeDir>
    <ZipDirectory SourceDirectory="$(TargetDir)" DestinationFile="$(PackageOutputPath)\$(TargetName).$(Version).cplz" Overwrite="true"/>
  </Target>
  <Target Name="Clean CPLZ" AfterTargets="AfterClean" Condition="$(ProjectType) == 'ProgramLibrary'">
    <Delete Files="$(PackageOutputPath)\$(TargetName).$(Version).cplz"/>
  </Target>
  <!-- Installs git hooks on restore; skipped in CI or with HUSKY=0 -->
  <Target Name="InstallGitHooks" BeforeTargets="Restore;CollectPackageReferences" Condition="'$(HUSKY)' != '0' And '$(CI)' != 'true' And Exists('$(MSBuildThisFileDirectory)..\.git')">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildThisFileDirectory).." StandardOutputImportance="Low" StandardErrorImportance="High" ContinueOnError="true" />
    <Exec Command="dotnet husky install" WorkingDirectory="$(MSBuildThisFileDirectory).." StandardOutputImportance="Low" StandardErrorImportance="High" ContinueOnError="true" />
  </Target>

  <!--
    README badges: .NET from $(TargetFramework), PepperDash Essentials from the highest
    MinimumEssentialsFrameworkVersion assignment in the project's C# files (factories can have any name).
    Rewritten before build locally;
    checked (build error on drift) when CI=true or -p:ReadmeMode=Check. Opt out: -p:SkipReadmeBadges=true
  -->
  <PropertyGroup>
    <ReadmePath Condition="'$(ReadmePath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../README.md'))</ReadmePath>
    <ReadmeMode Condition="'$(ReadmeMode)' == '' And '$(CI)' == 'true'">Check</ReadmeMode>
    <ReadmeMode Condition="'$(ReadmeMode)' == ''">Update</ReadmeMode>
    <_ReadmeBadgesEnabled Condition="'$(ProjectType)' == 'ProgramLibrary' And '$(DesignTimeBuild)' != 'true' And '$(TargetFramework)' != '' And '$(SkipReadmeBadges)' != 'true' And Exists('$(ReadmePath)')">true</_ReadmeBadgesEnabled>
    <_ReadmeBadgesStamp>$(IntermediateOutputPath)readme-badges.stamp</_ReadmeBadgesStamp>
  </PropertyGroup>

  <UsingTask TaskName="SyncReadmeBadges" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)../build/ReadmeBadges.cs" />
    </Task>
  </UsingTask>

  <Target Name="_CollectReadmeBadgeInputs" DependsOnTargets="_CollectReadmeSources">
    <PropertyGroup>
      <_ReadmeEssentialsVersion>@(PackageReference->WithMetadataValue('Identity', 'PepperDashEssentials')->'%(Version)')</_ReadmeEssentialsVersion>
    </PropertyGroup>
  </Target>

  <Target Name="UpdateReadmeBadges" BeforeTargets="BeforeBuild" DependsOnTargets="_CollectReadmeBadgeInputs"
          Condition="'$(_ReadmeBadgesEnabled)' == 'true' And '$(ReadmeMode)' != 'Check'"
          Inputs="@(_ReadmeSource);$(MSBuildProjectFullPath);$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)../build/ReadmeBadges.cs;$(ReadmePath)"
          Outputs="$(_ReadmeBadgesStamp)">
    <SyncReadmeBadges ReadmePath="$(ReadmePath)" TargetFramework="$(TargetFramework)" EssentialsPackageVersion="$(_ReadmeEssentialsVersion)" SourceFiles="@(_ReadmeSource)" />
    <!-- Touched after the README write: README is both an input and an output -->
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Touch Files="$(_ReadmeBadgesStamp)" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(_ReadmeBadgesStamp)" />
    </ItemGroup>
  </Target>

  <Target Name="CheckReadmeBadges" BeforeTargets="BeforeBuild" DependsOnTargets="_CollectReadmeBadgeInputs"
          Condition="'$(_ReadmeBadgesEnabled)' == 'true' And '$(ReadmeMode)' == 'Check'">
    <SyncReadmeBadges ReadmePath="$(ReadmePath)" TargetFramework="$(TargetFramework)" EssentialsPackageVersion="$(_ReadmeEssentialsVersion)" SourceFiles="@(_ReadmeSource)" CheckOnly="true" />
  </Target>

  <!--
    README docs: the START/END marker sections under "Plugin Documentation" (config example, supported types,
    join maps, feedbacks, public methods), generated from the project's C# files by build/ReadmeDocs.cs.
    Not part of the normal build: run `dotnet msbuild -t:UpdateReadmeDocs`, review the diff, commit it.
    Checked (build error on drift) when CI=true or -p:ReadmeMode=Check. Opt out: -p:SkipReadmeDocsCheck=true
  -->
  <PropertyGroup>
    <_ReadmeDocsEnabled Condition="'$(ProjectType)' == 'ProgramLibrary' And '$(DesignTimeBuild)' != 'true' And '$(TargetFramework)' != '' And Exists('$(ReadmePath)')">true</_ReadmeDocsEnabled>
  </PropertyGroup>

  <UsingTask TaskName="GenerateReadmeDocs" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)../build/ReadmeDocs.cs" />
    </Task>
  </UsingTask>

  <!-- The project's own C# files (generated bin/obj sources excluded), with paths relative to the project -->
  <Target Name="_CollectReadmeSources">
    <ItemGroup>
      <_ReadmeSource Include="@(Compile)" RelPath="$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)', '%(FullPath)'))" />
      <_ReadmeSource Remove="@(_ReadmeSource)" Condition="$([System.String]::Copy('%(RelPath)').StartsWith('..')) Or $([System.String]::Copy('%(RelPath)').StartsWith('obj')) Or $([System.String]::Copy('%(RelPath)').StartsWith('bin'))" />
    </ItemGroup>
  </Target>

  <!-- Skipped for projects that do not own the README (e.g. test projects), so it can be run against the solution -->
  <Target Name="UpdateReadmeDocs" DependsOnTargets="_CollectReadmeSources" Condition="'$(_ReadmeDocsEnabled)' == 'true'">
    <GenerateReadmeDocs ReadmePath="$(ReadmePath)" SourceFiles="@(_ReadmeSource)" />
  </Target>

  <Target Name="CheckReadmeDocs" AfterTargets="CheckReadmeBadges" DependsOnTargets="_CollectReadmeSources"
          Condition="'$(_ReadmeDocsEnabled)' == 'true' And '$(ReadmeMode)' == 'Check' And '$(SkipReadmeDocsCheck)' != 'true'">
    <GenerateReadmeDocs ReadmePath="$(ReadmePath)" SourceFiles="@(_ReadmeSource)" CheckOnly="true" />
  </Target>
</Project>
