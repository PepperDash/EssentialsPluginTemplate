<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Where the build tools restore from (PepperDash.Essentials.BuildTools.*, pinned in .config/dotnet-tools.json).

    nuget.org is the source: the tools are published there (public, no credentials), and that is how local builds
    and CI restore them. The PepperDash GitHub Packages feed (needs a token) is a fallback for the same packages,
    used only if you registered a source named exactly "github-pd" on your machine (see "Set up the PepperDash
    GitHub Packages fallback" in the README). NuGet does not try sources in order: with both mapped it uses
    whichever has the pinned version, so the fallback helps when a version is missing from nuget.org, not when
    nuget.org is unreachable.
    The pattern must stay under nuget.org too. If it were only under github-pd, the restore would fail for anyone
    who has not registered that source.

    Package source mapping is on, so every other package resolves only from nuget.org. If your plugin adds a
    dependency from a private feed (github-pd-engineering, github-pd-services, ...), add that feed here with a
    <package pattern="..." /> entry for its package ids. Do not put credentials in this file.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="PepperDash.Essentials.BuildTools.*" />
    </packageSource>
    <packageSource key="github-pd">
      <package pattern="PepperDash.Essentials.BuildTools.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
