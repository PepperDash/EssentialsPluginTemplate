{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install git hooks",
      "type": "shell",
      "command": "dotnet tool restore && dotnet husky install",
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "Update README docs",
      "type": "shell",
      "command": "pwsh -NoProfile -File .github/scripts/Update-ReadmeDocs.ps1",
      "windows": {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/scripts/Update-ReadmeDocs.ps1"
      },
      "problemMatcher": []
    }
  ]
}
