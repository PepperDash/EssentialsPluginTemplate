{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Restore dotnet tools",
      "type": "process",
      "command": "dotnet",
      "args": [
        "tool",
        "restore"
      ],
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Install git hooks",
      "type": "process",
      "command": "dotnet",
      "args": [
        "husky",
        "install"
      ],
      "dependsOn": "Restore dotnet tools",
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "Update README docs",
      "type": "process",
      "command": "dotnet",
      "args": [
        "msbuild",
        "-nologo",
        "-t:UpdateReadmeDocs"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Generate config schema",
      "type": "process",
      "command": "dotnet",
      "args": [
        "msbuild",
        "-nologo",
        "-t:UpdateConfigSchema"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
