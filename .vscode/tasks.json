{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install git hooks",
      "type": "shell",
      "command": "dotnet tool restore && dotnet husky install",
      "options": {
        "shell": {
          "executable": "pwsh",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    }
  ]
}
